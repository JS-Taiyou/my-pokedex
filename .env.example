# Supabase Postgres connection string (Dashboard -> Connect -> Session pooler):
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Port the Hono server listens on
PORT=3000

# Upstream data source. Backend-only by design: the browser never calls this.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# Politeness cap: max concurrent outbound requests to PokeAPI
POKEAPI_CONCURRENCY=4
